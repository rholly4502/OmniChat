<Project>
  <!-- ============================================================
       Fondasi Linter Terpusat — Step 2
       Berlaku otomatis untuk semua project di bawah repo ini
       ============================================================ -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- latest-recommended: set default analyzer yang direkomendasikan MS.
         (Untuk latest-all + triage via .editorconfig, bisa di-override.) -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- LINT MASTER (shared): analyzer DL100/DL101.
       Lokasi di-resolve dengan prioritas, supaya build tidak patah di mesin tanpa
       folder lint (mis. Windows lokal / orang lain yang clone):

         1. Env var LINT_RULES_PATH (kalau di-set, menang)
         2. Lokasi absolut dev box (/root/lint-rules) — single source hidup
         3. Fallback dalam repo: tools/lint-rules/ (letakkan salinan di sini
            kalau ingin lint aktif di mesin tanpa master lint)

       Jika tak satu pun ada, analyzer master dilewati (build tetap sukses),
       hanya DL100/DL101 yang tidak aktif. -->
  <PropertyGroup>
    <LintRulesProjectPath Condition="'$(LINT_RULES_PATH)' != ''">$(LINT_RULES_PATH)</LintRulesProjectPath>
    <LintRulesProjectPath Condition="'$(LintRulesProjectPath)' == '' and Exists('/root/lint-rules/LintRuleDemo.Analyzers/LintRuleDemo.Analyzers.csproj')">/root/lint-rules/LintRuleDemo.Analyzers/LintRuleDemo.Analyzers.csproj</LintRulesProjectPath>
    <LintRulesProjectPath Condition="'$(LintRulesProjectPath)' == '' and Exists('$(MSBuildThisFileDirectory)tools/lint-rules/LintRuleDemo.Analyzers/LintRuleDemo.Analyzers.csproj')">$(MSBuildThisFileDirectory)tools/lint-rules/LintRuleDemo.Analyzers/LintRuleDemo.Analyzers.csproj</LintRulesProjectPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(LintRulesProjectPath)' != ''">
    <ProjectReference Include="$(LintRulesProjectPath)"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- NuGet analyzers tambahan (PrivateAssets agar tidak bocor ke konsumen). -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" PrivateAssets="all" />
    <PackageReference Include="AsyncFixer" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- BannedApiAnalyzers: daftar API terlarang (lihat BannedSymbols.txt).
       RS0030 di-set error untuk kode produksi di .editorconfig;
       dikecualikan untuk [tests/**/*.cs]. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
