# ── OmniChat environment configuration ──
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored — NEVER commit it and NEVER commit real secrets.
# docker-compose reads `.env` automatically for the ${...} substitutions below.

# ── Direct LLM provider (OpenRouter) ──
# Only needed when the frontend uses "Direct" mode. Leave empty for Hermes-only use.
LLM_API_KEY=
LLM__Endpoint=https://openrouter.ai/api/v1/chat/completions

# ── Backend API key (Security:ApiKey) ──
# Sent by clients as the `X-Api-Key` request header.
# WARNING: If this is EMPTY the backend is OPEN: the API-key middleware passes
# every request through. Set a long random value in any non-local deployment.
Security__ApiKey=

# ── CORS allowed origins (Cors:AllowedOrigins) ──
# Comma-separated list of browser origins allowed to call the API,
# e.g. https://chat.example.com,https://app.example.com
# WARNING: If this is EMPTY the backend falls back to AllowAnyOrigin — any
# website can call the API. Set it explicitly in production.
Cors__AllowedOrigins=

# ── JWT signing key (Security:Jwt:SigningKey) ──
# HMAC-SHA256 secret used to validate `Authorization: Bearer <token>` requests.
# Leave empty to keep JWT auth disabled (API-key auth still applies).
Security__Jwt__SigningKey=
# JWT issuer claim (Security:Jwt:Issuer). Defaults to "OmniChat".
Security__Jwt__Issuer=OmniChat
# JWT audience claim (Security:Jwt:Audience). Defaults to "OmniChat".
Security__Jwt__Audience=OmniChat

# ── History readers (Security:AdminSubjects) ──
# JWT subjects allowed to READ stored chat history. Comma-separated here, or indexed
# (Security__AdminSubjects__0=…) in appsettings. Every caller's turns are still written to
# the database — this list only decides whose sidebar can list them back. An API-key caller
# is always admin (the key IS the operator credential); an unlisted JWT holder is a guest.
# Leave empty to grant no JWT holder history access.
Security__AdminSubjects=

# ── Hermes gateway (Hermes:Endpoint + Hermes:ApiKey) ──
# Inside Docker the Hermes gateway runs on the host, reachable via
# host.docker.internal (see extra_hosts in docker-compose.yml).
Hermes__Endpoint=http://host.docker.internal:5000/v1/chat/completions
# Hermes API key — sent as Authorization: Bearer *** to the Hermes gateway.
# Get this from Hermes config: /opt/data/profiles/default/config.yaml (api_key).
# If Hermes runs without auth (localhost only), leave empty.
Hermes__ApiKey=

# ── Request body size limit (Kestrel:MaxRequestBodySizeBytes) ──
# Maximum request body size in bytes. Default: 10485760 (10 MB).
# Set to a smaller value to further limit payload sizes.
Kestrel__MaxRequestBodySizeBytes=10485760

# ── Reverse proxy / forwarded headers (ReverseProxy:*) ──
# Enable ONLY when the backend runs behind a reverse proxy (nginx, Caddy, Traefik, ...)
# that sets X-Forwarded-For / X-Forwarded-Proto. Off by default (safe: headers ignored).
# Without a trusted proxy the client IP is the proxy's address, so the per-IP rate
# limiter collapses every client into one bucket and access logs show the proxy.
ReverseProxy__Enabled=false
# Trusted proxy IPs (comma-separated), e.g. 10.0.0.5,10.0.0.6
ReverseProxy__KnownProxies=
# Trusted proxy CIDR networks (comma-separated). Docker bridge example: 172.18.0.0/16
ReverseProxy__KnownNetworks=
# Max forwarded entries to process (default 1 = only the closest proxy's entry).
ReverseProxy__ForwardLimit=1

# ── Frontend /api proxy target (local dev only) ──
# Used by `npm run dev` and `npm run preview` (vite dev/preview server proxy).
# NOT used in Docker — the frontend Docker image uses nginx, which proxies /api/*
# to the backend service directly (see frontend/nginx.conf).
VITE_API_PROXY_TARGET=http://localhost:5184

# ── Rate limiting (RateLimit:*) ──
# Per-IP token-bucket rate limiter. Defaults: 10 requests / 60 seconds.
# Tune for your workload without code changes.
RateLimit__TokenLimit=
RateLimit__ReplenishmentPeriodSeconds=

# ── Upstream streaming liveness deadline (Streaming:IdleTimeoutSeconds) ──
# Abort the upstream call after this many seconds with no bytes received, so a provider
# that accepts the request and then goes quiet cannot hang the request forever. The
# deadline is renewed on every line read, so a stream that keeps producing is never cut
# short no matter how long the full answer takes. Default: 120. 0 or negative disables it.
Streaming__IdleTimeoutSeconds=120

# ── Model catalog (Models:Agent / Models:Direct) ──
# Optional. Overrides the built-in model list shown by GET /api/models.
# Each value is a JSON array of {"Id","Label"} objects — leave empty to keep
# the built-in defaults. Indexed keys (Models__Agent__0__Id=…) also work, and
# win when both forms are supplied.
#   Models__Agent=[{"Id":"hermes","Label":"Hermes (Default)"},{"Id":"gpt-4o","Label":"GPT-4o"}]
#   Models__Direct=[{"Id":"meta-llama/llama-3.3-70b-instruct:free","Label":"Llama 3.3 70B (Free)"}]
Models__Agent=
Models__Direct=

# ── Chat history persistence (Persistence:*) ──
# Stores every streamed turn in SQLite so a conversation can be reopened and audited.
# Disabling this does not disable chat: streaming works with history off, it just keeps
# no record. In Docker the path must be inside the mounted volume, because anything
# outside it is lost on the next `docker compose up --build`.
Persistence__Enabled=true
Persistence__ConnectionString=Data Source=/data/omnichat.db
