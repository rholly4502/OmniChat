# ── OmniChat environment configuration ──
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored — NEVER commit it and NEVER commit real secrets.
# docker-compose reads `.env` automatically for the ${...} substitutions below.

# ── Direct LLM provider (OpenRouter) ──
# Only needed when the frontend uses "Direct" mode. Leave empty for Hermes-only use.
LLM_API_KEY=
LLM__Endpoint=https://openrouter.ai/api/v1/chat/completions

# ── Backend API key (Security:ApiKey) ──
# Sent by clients as the `X-Api-Key` request header.
# WARNING: If this is EMPTY the backend is OPEN: the API-key middleware passes
# every request through. Set a long random value in any non-local deployment.
Security__ApiKey=

# ── CORS allowed origins (Cors:AllowedOrigins) ──
# Comma-separated list of browser origins allowed to call the API,
# e.g. https://chat.example.com,https://app.example.com
# WARNING: If this is EMPTY the backend falls back to AllowAnyOrigin — any
# website can call the API. Set it explicitly in production.
Cors__AllowedOrigins=

# ── JWT signing key (Security:Jwt:SigningKey) ──
# HMAC-SHA256 secret used to validate `Authorization: Bearer <token>` requests.
# Leave empty to keep JWT auth disabled (API-key auth still applies).
Security__Jwt__SigningKey=
# JWT issuer claim (Security:Jwt:Issuer). Defaults to "OmniChat".
Security__Jwt__Issuer=OmniChat
# JWT audience claim (Security:Jwt:Audience). Defaults to "OmniChat".
Security__Jwt__Audience=OmniChat

# ── Hermes gateway endpoint (Hermes:Endpoint) ──
# Inside Docker the Hermes gateway runs on the host, reachable via
# host.docker.internal (see extra_hosts in docker-compose.yml).
Hermes__Endpoint=http://host.docker.internal:5000/v1/chat/completions

# ── Request body size limit (Kestrel:MaxRequestBodySizeBytes) ──
# Maximum request body size in bytes. Default: 10485760 (10 MB).
# Set to a smaller value to further limit payload sizes.
Kestrel__MaxRequestBodySizeBytes=10485760

# ── Reverse proxy / forwarded headers (ReverseProxy:*) ──
# Enable ONLY when the backend runs behind a reverse proxy (nginx, Caddy, Traefik, ...)
# that sets X-Forwarded-For / X-Forwarded-Proto. Off by default (safe: headers ignored).
# Without a trusted proxy the client IP is the proxy's address, so the per-IP rate
# limiter collapses every client into one bucket and access logs show the proxy.
ReverseProxy__Enabled=false
# Trusted proxy IPs (comma-separated), e.g. 10.0.0.5,10.0.0.6
ReverseProxy__KnownProxies=
# Trusted proxy CIDR networks (comma-separated). Docker bridge example: 172.18.0.0/16
ReverseProxy__KnownNetworks=
# Max forwarded entries to process (default 1 = only the closest proxy's entry).
ReverseProxy__ForwardLimit=1

# ── Frontend /api proxy target (dev + `vite preview`) ──
# Local dev: leave as-is (backend on the host).
# Docker: docker-compose overrides this with http://backend:5184.
VITE_API_PROXY_TARGET=http://localhost:5184
