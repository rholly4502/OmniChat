# Caddyfile — reverse proxy + auto SSL (Let's Encrypt)
# Ganti rhol-ai.tech dengan domain kamu
rhol-ai.tech {
	# Health check -> backend (public endpoint, no API key required)
	reverse_proxy /health backend:5184

	# API requests -> backend (flush_interval -1 = SSE streaming tanpa buffering)
	reverse_proxy /api/* backend:5184 {
		flush_interval -1
	}

	# ShortLink API (subpath; frontend belakangan) -> shared network
	reverse_proxy /shortlink/api/* shortlink-api:8080

	# QAnalyzer Web (SPA + API di /analyzer) -> shared network
	reverse_proxy /analyzer/* qanalyzer-web:8080

	# Everything else -> frontend OmniChat
	reverse_proxy /* frontend:4173
}
